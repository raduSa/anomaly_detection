\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces LSTM Autoencoder -- per-timestep squared reconstruction error on 300 randomly sampled anomalous A3 windows (one row per window, left). Elevated error appears as sparse, punctate points rather than as a uniform band, but a visibly larger share of rows carry a low-level elevated baseline across most of their width compared to the Transformer.}}{36}{figure.5.1}\protected@file@percent }
\newlabel{fig:explain-lstm-heatmap}{{5.1}{36}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces LSTM Autoencoder -- per-timestep squared reconstruction error on 300 randomly sampled anomalous A3 windows (one row per window, left). Elevated error appears as sparse, punctate points rather than as a uniform band, but a visibly larger share of rows carry a low-level elevated baseline across most of their width compared to the Transformer}{figure.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Transformer Bottleneck Autoencoder -- per-timestep squared reconstruction error on the same 300 anomalous A3 windows, same row order and colour scale convention as Figure~\ref {fig:explain-lstm-heatmap} (right). Error is visibly more sparse and confined to isolated timesteps.}}{36}{figure.5.2}\protected@file@percent }
\newlabel{fig:explain-transformer-heatmap}{{5.2}{36}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Transformer Bottleneck Autoencoder -- per-timestep squared reconstruction error on the same 300 anomalous A3 windows, same row order and colour scale convention as Figure~\ref {fig:explain-lstm-heatmap} (right). Error is visibly more sparse and confined to isolated timesteps}{figure.5.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1.3}Quantitative Verification: Gini Coefficient of Error Concentration}{37}{subsection.5.1.3}\protected@file@percent }
\newlabel{eq:gini}{{5.1}{37}{Quantitative Verification: Gini Coefficient of Error Concentration}{equation.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Distribution of per-window Gini coefficients across all 14{,}449 anomalous A3 windows. The Transformer's distribution is unimodal and shifted toward high concentration (Gini $>0.6$); the LSTM Autoencoder's distribution is bimodal, with a majority clustered near the Transformer's range but a distinct secondary population spread across low Gini values (error genuinely smeared across the window).}}{38}{figure.5.3}\protected@file@percent }
\newlabel{fig:explain-gini}{{5.3}{38}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Distribution of per-window Gini coefficients across all 14{,}449 anomalous A3 windows. The Transformer's distribution is unimodal and shifted toward high concentration (Gini $>0.6$); the LSTM Autoencoder's distribution is bimodal, with a majority clustered near the Transformer's range but a distinct secondary population spread across low Gini values (error genuinely smeared across the window)}{figure.5.3}{}}
