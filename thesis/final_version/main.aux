\@writefile{toc}{\contentsline {subsection}{\numberline {5.1.1}Verificare Calitativă: Hărți Termice ale Erorii per Pas Temporal}{27}{subsection.5.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces LSTM Autoencoder -- eroarea pătratică de reconstrucție per pas temporal pe 300 de ferestre A3 anormale, eșantionate aleator (câte un rând per fereastră, stânga). Eroarea ridicată apare ca puncte rare, mai degrabă decât ca o bandă uniformă, dar o proporție vizibil mai mare de rânduri prezintă un nivel de bază ușor ridicat pe aproape toată lățimea, comparativ cu Transformer-ul.}}{28}{figure.5.1}\protected@file@percent }
\newlabel{fig:explain-lstm-heatmap}{{5.1}{28}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces LSTM Autoencoder -- eroarea pătratică de reconstrucție per pas temporal pe 300 de ferestre A3 anormale, eșantionate aleator (câte un rând per fereastră, stânga). Eroarea ridicată apare ca puncte rare, mai degrabă decât ca o bandă uniformă, dar o proporție vizibil mai mare de rânduri prezintă un nivel de bază ușor ridicat pe aproape toată lățimea, comparativ cu Transformer-ul}{figure.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Transformer Bottleneck Autoencoder -- eroarea pătratică de reconstrucție per pas temporal pe aceleași 300 de ferestre A3 anormale, aceeași ordine a rândurilor și aceeași convenție de scală de culoare ca în Figura~\ref {fig:explain-lstm-heatmap} (dreapta). Eroarea este vizibil mai rară și limitată la pași temporali izolați.}}{28}{figure.5.2}\protected@file@percent }
\newlabel{fig:explain-transformer-heatmap}{{5.2}{28}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Transformer Bottleneck Autoencoder -- eroarea pătratică de reconstrucție per pas temporal pe aceleași 300 de ferestre A3 anormale, aceeași ordine a rândurilor și aceeași convenție de scală de culoare ca în Figura~\ref {fig:explain-lstm-heatmap} (dreapta). Eroarea este vizibil mai rară și limitată la pași temporali izolați}{figure.5.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1.2}Verificare Cantitativă: Coeficientul Gini al Concentrării Erorii}{29}{subsection.5.1.2}\protected@file@percent }
\newlabel{eq:gini}{{5.1}{29}{Verificare Cantitativă: Coeficientul Gini al Concentrării Erorii}{equation.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Distribuția coeficienților Gini per fereastră, pe toate cele 14{,}449 ferestre A3 anormale. Distribuția Transformer-ului este unimodală și deplasată spre concentrare ridicată (Gini $>0.6$); distribuția LSTM Autoencoder-ului este bimodală, cu o majoritate grupată aproape de intervalul Transformer-ului, dar cu o populație secundară distinctă răspândită la valori Gini scăzute.}}{29}{figure.5.3}\protected@file@percent }
\newlabel{fig:explain-gini}{{5.3}{29}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Distribuția coeficienților Gini per fereastră, pe toate cele 14{,}449 ferestre A3 anormale. Distribuția Transformer-ului este unimodală și deplasată spre concentrare ridicată (Gini $>0.6$); distribuția LSTM Autoencoder-ului este bimodală, cu o majoritate grupată aproape de intervalul Transformer-ului, dar cu o populație secundară distinctă răspândită la valori Gini scăzute}{figure.5.3}{}}
