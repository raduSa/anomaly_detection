\@writefile{toc}{\contentsline {subsection}{\numberline {5.1.1}Initial Assumption}{31}{subsection.5.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1.2}Qualitative Check: Per-Timestep Error Heatmaps}{31}{subsection.5.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces LSTM Autoencoder -- per-timestep squared reconstruction error on 300 randomly sampled anomalous A3 windows (one row per window, left). Elevated error appears as sparse, punctate points rather than as a uniform band, but a visibly larger share of rows carry a low-level elevated baseline across most of their width compared to the Transformer.}}{32}{figure.5.1}\protected@file@percent }
\newlabel{fig:explain-lstm-heatmap}{{5.1}{32}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces LSTM Autoencoder -- per-timestep squared reconstruction error on 300 randomly sampled anomalous A3 windows (one row per window, left). Elevated error appears as sparse, punctate points rather than as a uniform band, but a visibly larger share of rows carry a low-level elevated baseline across most of their width compared to the Transformer}{figure.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Transformer Bottleneck Autoencoder -- per-timestep squared reconstruction error on the same 300 anomalous A3 windows, same row order and colour scale convention as Figure~\ref {fig:explain-lstm-heatmap} (right). Error is visibly more sparse and confined to isolated timesteps.}}{32}{figure.5.2}\protected@file@percent }
\newlabel{fig:explain-transformer-heatmap}{{5.2}{32}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Transformer Bottleneck Autoencoder -- per-timestep squared reconstruction error on the same 300 anomalous A3 windows, same row order and colour scale convention as Figure~\ref {fig:explain-lstm-heatmap} (right). Error is visibly more sparse and confined to isolated timesteps}{figure.5.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1.3}Quantitative Verification: Gini Coefficient of Error Concentration}{33}{subsection.5.1.3}\protected@file@percent }
\newlabel{eq:gini}{{5.1}{33}{Quantitative Verification: Gini Coefficient of Error Concentration}{equation.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Distribution of per-window Gini coefficients across all 14{,}449 anomalous A3 windows. The Transformer's distribution is unimodal and shifted toward high concentration (Gini $>0.6$); the LSTM Autoencoder's distribution is bimodal, with a majority clustered near the Transformer's range but a distinct secondary population spread across low Gini values (error genuinely smeared across the window).}}{34}{figure.5.3}\protected@file@percent }
\newlabel{fig:explain-gini}{{5.3}{34}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Distribution of per-window Gini coefficients across all 14{,}449 anomalous A3 windows. The Transformer's distribution is unimodal and shifted toward high concentration (Gini $>0.6$); the LSTM Autoencoder's distribution is bimodal, with a majority clustered near the Transformer's range but a distinct secondary population spread across low Gini values (error genuinely smeared across the window)}{figure.5.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.2}Disjoint Feature Regimes: AE+Context vs.\ Temporal IForest}{34}{section.5.2}\protected@file@percent }
\newlabel{sec:explain-disjoint-regime}{{5.2}{34}{Disjoint Feature Regimes: AE+Context vs.\ Temporal IForest}{section.5.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2.1}Temporal IForest: Initial Assumption}{35}{subsection.5.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2.2}Temporal IForest: Score Validity Under Last-Flow Labeling}{35}{subsection.5.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2.3}Temporal IForest: SHAP Attribution Across the Window}{35}{subsection.5.2.3}\protected@file@percent }
\newlabel{sec:explain-temporal-window}{{5.2.3}{35}{Temporal IForest: SHAP Attribution Across the Window}{subsection.5.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Temporal IForest -- mean SHAP value per timestep for the six most-attributed features, DDoS windows (left) and DoS slowloris windows (right). In both cases attribution is negative (anomalous), recurs at consistent sign across most of the 16 timesteps, and does not concentrate at the final flow (dashed red line) -- the flow paired with AE+Context's score in the proposed ensemble.}}{36}{figure.5.4}\protected@file@percent }
\newlabel{fig:explain-temporal-shap}{{5.4}{36}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Temporal IForest -- mean SHAP value per timestep for the six most-attributed features, DDoS windows (left) and DoS slowloris windows (right). In both cases attribution is negative (anomalous), recurs at consistent sign across most of the 16 timesteps, and does not concentrate at the final flow (dashed red line) -- the flow paired with AE+Context's score in the proposed ensemble}{figure.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Temporal IForest -- mean $|\text  {SHAP}|$ summed over features, per timestep, DDoS windows (left) and DoS slowloris windows (right). The final timestep (red bar, 15) -- the flow paired with AE+Context's score in the proposed ensemble -- carries no more attribution mass than any other position in the window, confirming the summary statistic reported below.}}{36}{figure.5.5}\protected@file@percent }
\newlabel{fig:explain-temporal-position-concentration}{{5.5}{36}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Temporal IForest -- mean $|\text {SHAP}|$ summed over features, per timestep, DDoS windows (left) and DoS slowloris windows (right). The final timestep (red bar, 15) -- the flow paired with AE+Context's score in the proposed ensemble -- carries no more attribution mass than any other position in the window, confirming the summary statistic reported below}{figure.5.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces Temporal IForest -- SHAP beeswarm per feature, DDoS windows (left) and DoS slowloris windows (right), collapsing the 16-timestep axis by summing each feature's SHAP contribution across the window and coloring by that feature's mean value across the window. DoS slowloris shows a clean monotonic relationship -- high inter-arrival-time values drive strongly negative (anomalous) SHAP, low values push near zero -- consistent with the slow, connection-holding behaviour the attack is named for. DDoS shows a noisier value-to-sign relationship for its backward-packet-length features, and a wider per-window spread than the mean-only view in Figure~\ref {fig:explain-temporal-shap} suggests on its own.}}{37}{figure.5.6}\protected@file@percent }
\newlabel{fig:explain-temporal-beeswarm}{{5.6}{37}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Temporal IForest -- SHAP beeswarm per feature, DDoS windows (left) and DoS slowloris windows (right), collapsing the 16-timestep axis by summing each feature's SHAP contribution across the window and coloring by that feature's mean value across the window. DoS slowloris shows a clean monotonic relationship -- high inter-arrival-time values drive strongly negative (anomalous) SHAP, low values push near zero -- consistent with the slow, connection-holding behaviour the attack is named for. DDoS shows a noisier value-to-sign relationship for its backward-packet-length features, and a wider per-window spread than the mean-only view in Figure~\ref {fig:explain-temporal-shap} suggests on its own}{figure.5.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2.4}AE+Context: SHAP Dominated by Host-Context Features}{37}{subsection.5.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces \xpg@aux {}{romanian}\ignorespaces AE+Context -- SHAP summary plot, PortScan samples. \texttt  {ctx\_min\_port\_cnt} dominates with a tight, uniformly positive-SHAP cluster well separated from every other feature; the remaining top rows are almost entirely \texttt  {ctx\_*} host-context features, with ordinary flow features only appearing near the bottom of the ranking.}}{38}{figure.5.7}\protected@file@percent }
\newlabel{fig:explain-ae-context-portscan-shap}{{5.7}{38}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces AE+Context -- SHAP summary plot, PortScan samples. \texttt {ctx\_min\_port\_cnt} dominates with a tight, uniformly positive-SHAP cluster well separated from every other feature; the remaining top rows are almost entirely \texttt {ctx\_*} host-context features, with ordinary flow features only appearing near the bottom of the ranking}{figure.5.7}{}}
